# Copy to .env. The buns CLI loads it automatically; never commit .env.
BUNS_DATA_DIR=data
# Only required for serving beyond localhost. Use at least 24 random characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BUNS_AUTH_TOKEN=
BUNS_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional provider secrets; connection settings reference these variable NAMES.
BUNS_API_KEY=
OPENROUTER_API_KEY=
BRAVE_API_KEY=
REPLICATE_API_TOKEN=
