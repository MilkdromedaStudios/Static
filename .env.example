# Copy to .env. The static-ai CLI loads it automatically; never commit .env.
STATIC_DATA_DIR=data
# Only required for serving beyond localhost. Use at least 24 random characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STATIC_AUTH_TOKEN=
STATIC_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional provider secrets; connection settings reference these variable NAMES.
STATIC_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
BRAVE_API_KEY=
REPLICATE_API_TOKEN=

# Optional: start with an API-key language model, without installing Ollama.
# Fill all fields below using your provider's real model ID and current rates.
# openai (default), anthropic, or claude_code (an installed, signed-in Claude Code; no key needed).
# STATIC_CHAT_PROVIDER=openai
# STATIC_CHAT_NAME=My API model
# STATIC_CHAT_MODEL=your-tool-capable-model-id
# STATIC_CHAT_BASE_URL=https://your-provider.example/v1
# STATIC_CHAT_KEY_ENV=STATIC_API_KEY
# STATIC_CHAT_INPUT_PER_MILLION=0
# STATIC_CHAT_OUTPUT_PER_MILLION=0
# STATIC_CHAT_PRICING_CONFIRMED=true

# Optional: the Claude Code CLI to use when it is not on PATH (Windows: the native claude.exe).
# STATIC_CLAUDE_CODE_PATH=

# Docker only: reuse an existing data volume when upgrading (see docs/MIGRATION.md).
# STATIC_DATA_VOLUME=static-workspace-data
