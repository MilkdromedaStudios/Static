# Copy to .env. The static-ai CLI loads it automatically; never commit .env.
STATIC_DATA_DIR=data
# Only required for serving beyond localhost. Use at least 24 random characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STATIC_AUTH_TOKEN=
STATIC_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional provider secrets; connection settings reference these variable NAMES.
STATIC_API_KEY=
OPENROUTER_API_KEY=
BRAVE_API_KEY=
REPLICATE_API_TOKEN=

# Docker only: reuse an existing data volume when upgrading (see docs/MIGRATION.md).
# STATIC_DATA_VOLUME=static-workspace-data
